{
  "name": "playwright-flight-booking-tests",
  "version": "1.0.0",
  "description": "End-to-end and API test automation for a flight booking web app, built with Playwright and TypeScript.",
  "author": "Islam Hassan",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
